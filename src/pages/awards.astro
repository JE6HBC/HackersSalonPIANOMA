---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHallOfFame } from '../lib/data';
import { formatDateShort } from '../lib/format';
import { href } from '../lib/url';

const awards = await getCollection('awards');
const awardById = new Map(awards.map((a) => [a.id, a.data] as const));
const hallOfFame = await getHallOfFame();
---

<BaseLayout title="殿堂" description="Hacker's Bar @ PIANOMA の受賞歴アーカイブ。">
  <h1>殿堂 / Hall of Fame</h1>
  <p class="muted">
    各回の <code>results.json</code> を集計しています。受賞の記録漏れを見つけたら Pull Requestで直してください。
  </p>

  <section class="stack">
    <h2>賞の一覧</h2>
    <div class="grid">
      {
        awards.map((award) => (
          <div class="card award">
            <span class="award__emoji">{award.data.emoji}</span>
            <div>
              <strong>{award.data.name}</strong>
              <p class="muted">{award.data.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="stack">
    <h2>受賞者</h2>
    {
      hallOfFame.length > 0 ? (
        <table>
          <thead>
            <tr>
              <th>受賞者</th>
              <th>回数</th>
              <th>受賞歴</th>
            </tr>
          </thead>
          <tbody>
            {hallOfFame.map((row) => (
              <tr>
                <td>
                  <strong>{row.displayName}</strong>
                  {row.github && (
                    <div class="dim">
                      <a href={`https://github.com/${row.github}`}>@{row.github}</a>
                    </div>
                  )}
                </td>
                <td>{row.awards.length}</td>
                <td>
                  <ul class="history">
                    {row.awards.map((entry) => (
                      <li>
                        <span>{awardById.get(entry.awardId)?.emoji ?? '🏅'}</span>
                        <span>{awardById.get(entry.awardId)?.name ?? entry.awardId}</span>
                        <a class="dim" href={href(`/events/${entry.eventId}`)}>
                          {formatDateShort(entry.eventId)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="muted">まだ受賞記録がありません。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  section + section {
    margin-top: var(--space-8);
  }
  .award {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .award__emoji {
    font-size: var(--text-2xl);
  }
  .award p {
    margin: var(--space-1) 0 0;
  }
  .history {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .history li {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }
</style>
